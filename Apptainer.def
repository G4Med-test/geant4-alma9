Bootstrap: dnf
OSVersion: 9
MirrorURL: https://repo.almalinux.org/almalinux/%{OSVERSION}/BaseOS/{{ ALMA_ARCH }}/os
Include: dnf ca-certificates
Setopt: install_weak_deps=False

# AlmaLinux is installed from RPMs, without an OCI/Docker base image.
# GEANT4_TAG and GEANT4_COMMIT must be supplied by the tag resolver; ALMA_ARCH
# (x86_64 or aarch64) must match the build host: each arch is built natively.
%arguments
    BUILD_JOBS=2
    SOURCE_REVISION=unknown

%files
    requirements.txt /opt/g4med/requirements.txt

%post -c /bin/bash
    set -euo pipefail
    [[ '{{ GEANT4_COMMIT }}' =~ ^[0-9a-f]{40}$ ]]
    [[ '{{ GEANT4_TAG }}' =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9][A-Za-z0-9.-]*)?$ ]]
    [[ '{{ BUILD_JOBS }}' =~ ^[1-9][0-9]*$ ]]
    [[ "$(uname -m)" == '{{ ALMA_ARCH }}' ]]

    # Keep compilers: the derived Apptainer images build the validation programs.
    # `geant4-config --install-datasets` looks up curl, md5sum and tar with `which`.
    dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake expat-devel \
        python3.12 python3.12-pip curl tar gzip which ca-certificates
    python3.12 -m venv /opt/venv
    /opt/venv/bin/python -m pip install --no-cache-dir --only-binary=:all: \
        -r /opt/g4med/requirements.txt

    mkdir -p /tmp/geant4/src
    curl -fLsS --retry 5 \
        'https://codeload.github.com/Geant4/geant4/tar.gz/{{ GEANT4_COMMIT }}' \
        -o /tmp/geant4/source.tar.gz
    tar -xzf /tmp/geant4/source.tar.gz -C /tmp/geant4/src --strip-components=1
    cmake -S /tmp/geant4/src -B /tmp/geant4/build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/geant4 \
        -DGEANT4_INSTALL_DATA=OFF -DGEANT4_INSTALL_DATADIR=/g4data \
        -DGEANT4_BUILD_MULTITHREADED=ON -DGEANT4_BUILD_TLS_MODEL=global-dynamic \
        -DGEANT4_USE_SYSTEM_EXPAT=ON -DGEANT4_USE_GDML=OFF \
        -DGEANT4_USE_QT=OFF -DGEANT4_USE_OPENGL_X11=OFF \
        -DGEANT4_INSTALL_EXAMPLES=OFF
    cmake --build /tmp/geant4/build --parallel '{{ BUILD_JOBS }}'
    cmake --install /tmp/geant4/build --strip
    rm -rf /tmp/geant4
    dnf clean all
    rm -rf /var/cache/dnf /var/cache/yum-bootstrap

    mkdir -p /g4data /workspace
    chmod 1777 /g4data /workspace
    ln -s /g4data /opt/geant4/data

%environment
    export PATH=/opt/venv/bin:/opt/geant4/bin:$PATH
    export LD_LIBRARY_PATH=/opt/geant4/lib64:/opt/geant4/lib:${LD_LIBRARY_PATH:-}
    export CMAKE_PREFIX_PATH=/opt/geant4
    export G4INSTALL=/opt/geant4
    export GEANT4_DATA_DIR=/g4data
    export G4DATA_DIR=/g4data
    export CC=/usr/bin/gcc CXX=/usr/bin/g++
    export LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1

%labels
    org.opencontainers.image.title G4Med Geant4 AlmaLinux 9
    org.opencontainers.image.source https://github.com/G4Med-test/geant4-alma9
    org.opencontainers.image.version {{ GEANT4_TAG }}
    org.opencontainers.image.revision {{ SOURCE_REVISION }}
    org.g4med.geant4.commit {{ GEANT4_COMMIT }}
    org.g4med.build.backend apptainer-dnf
    org.g4med.build.arch {{ ALMA_ARCH }}

%test
    set -eu
    geant4-config --version
    which curl md5sum tar > /dev/null  # needed by geant4-config --install-datasets
    python3 -c 'import uproot, numpy; import importlib.util; assert importlib.util.find_spec("ROOT") is None'
    test ! -e /tmp/geant4

%runscript
    exec /bin/bash "$@"

%help
    AlmaLinux 9 and Geant4 for G4Med batch validation.
    Mount physics datasets at /g4data. Python/uproot is available in /opt/venv.
